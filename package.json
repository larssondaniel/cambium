{
  "name": "cambium",
  "description": "GitHub Action that diffs a committed GraphQL schema between a pull request's merge-base and head and reports the result in one PR comment",
  "version": "1.1.0",
  "author": "Daniel Larsson",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/larssondaniel/cambium",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larssondaniel/cambium.git"
  },
  "bugs": {
    "url": "https://github.com/larssondaniel/cambium/issues"
  },
  "keywords": [
    "actions",
    "graphql",
    "schema",
    "diff",
    "breaking-changes",
    "pull-request"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "package": "npx rimraf ./dist && npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "package:watch": "npm run package -- --watch",
    "screenshots": "npx tsx scripts/screenshot/screenshots.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.1.1",
    "graphql": "^17.0.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@github/local-action": "^7.0.1",
    "@jest/globals": "^30.2.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.0",
    "eslint-plugin-prettier": "^5.5.5",
    "github-markdown-css": "5.9.0",
    "jest": "^30.2.0",
    "marked": "18.1.2",
    "playwright": "1.64.1",
    "prettier": "^3.8.1",
    "rollup": "^4.65.1",
    "ts-jest": "^29.4.6",
    "ts-jest-resolver": "^2.0.1",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
